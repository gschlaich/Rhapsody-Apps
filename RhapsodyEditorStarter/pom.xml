<project>
	<modelVersion>4.0.0</modelVersion>
	<groupId>RhapsodyEditorStarter</groupId>
	<artifactId>RhapsodyEditorStarter</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<build>
		<sourceDirectory>src</sourceDirectory>
	</build>
	<dependencies>
		<dependency>
			<groupId>com.fifesoft</groupId>
			<artifactId>rsyntaxtextarea</artifactId>
			<version>3.6.0</version>
		</dependency>
		<dependency>
			<groupId>com.fifesoft</groupId>
			<artifactId>autocomplete</artifactId>
			<version>3.3.2</version>
		</dependency>
		<dependency>
			<groupId>com.formdev</groupId>
			<artifactId>flatlaf</artifactId>
			<version>3.4</version>
		</dependency>
	</dependencies>
	<profiles>
		<profile>
			<id>USM</id>
			<activation>
				<property>
					<name>env.USM_ROOT</name>
				</property>
			</activation>
			<properties>
				<usmroot>${env.USM_ROOT}</usmroot>
			</properties>
			<dependencies>
				<dependency>
					<groupId>vendor.local</groupId>
					<artifactId>cdt</artifactId>
					<version>1.0</version>
					<scope>system</scope>
					<systemPath>${usmroot}/Development/Share/Profiles/Bernina/CDT/cdt.jar</systemPath>
				</dependency>
				<dependency>
					<groupId>vendor.local</groupId>
					<artifactId>equinox</artifactId>
					<version>1.0</version>
					<scope>system</scope>
					<systemPath>${usmroot}/Development/Share/Profiles/Bernina/CDT/equinox-common-3.2.0.jar</systemPath>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>rhapsody-local</id>
			<activation>
				<property>
					<name>env.OMROOT</name>
				</property>
			</activation>

			<properties>
				<omroot>${env.OMROOT}</omroot>
			</properties>

			<dependencies>
				<dependency>
					<groupId>vendor.local</groupId>
					<artifactId>rhapsody</artifactId>
					<version>1.0</version>
					<scope>system</scope>
					<systemPath>${omroot}/JavaAPI/Rhapsody.jar</systemPath>
				</dependency>

				<dependency>
					<groupId>vendor.local</groupId>
					<artifactId>apps</artifactId>
					<version>1.0</version>
					<scope>system</scope>
					<systemPath>${omroot}/RhapsodyApps/apps.jar</systemPath>
				</dependency>

				<dependency>
					<groupId>vendor.local</groupId>
					<artifactId>rhapsodyapps</artifactId>
					<version>1.0</version>
					<scope>system</scope>
					<systemPath>${omroot}/RhapsodyApps/RhapsodyApps.jar</systemPath>
				</dependency>

				<dependency>
					<groupId>vendor.local</groupId>
					<artifactId>swt</artifactId>
					<version>1.0</version>
					<scope>system</scope>
					<systemPath>${omroot}/RhapsodyApps/libs/swt.jar</systemPath>
				</dependency>

				<dependency>
					<groupId>vendor.local</groupId>
					<artifactId>jdom</artifactId>
					<version>1.0</version>
					<scope>system</scope>
					<systemPath>${omroot}/RhapsodyApps/libs/jdom.jar</systemPath>
				</dependency>


			</dependencies>

		</profile>
	</profiles>


</project>